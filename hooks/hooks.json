{
  "description": "ToolUseProxy checks every Hook-visible local function-tool input before execution, records tool results locally, and reviews final responses for protected content. Unknown local function tools are treated conservatively when protected information reaches their input. Hosted tools cannot be intercepted, so SessionStart and SubagentStart add a developer-context safety boundary instead. It stays local by default. The experimental Externality Judge sends only a value-free structural summary to the model provider you explicitly select.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/run_hook.sh\" session-start",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run_hook.cmd\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/run_hook.sh\" subagent-start",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run_hook.cmd\" subagent-start",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^.*$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/run_hook.sh\" pre-tool-use",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run_hook.cmd\" pre-tool-use",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^.*$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/run_hook.sh\" post-tool-use",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run_hook.cmd\" post-tool-use",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/run_hook.sh\" stop",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run_hook.cmd\" stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
