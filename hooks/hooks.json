{
  "description": "ToolUseProxy checks supported local function-tool inputs before execution, records tool results locally, and reviews final responses for protected content. Hosted tools cannot be intercepted, so SessionStart and SubagentStart add a developer-context safety boundary instead. It stays local by default. The experimental Externality Judge sends only a value-free structural summary to the model provider you explicitly select.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/run_hook.sh\" session-start",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run_hook.cmd\" session-start",
            "timeout": 10,
            "statusMessage": "ToolUseProxyの保護範囲を確認しています"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/run_hook.sh\" subagent-start",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run_hook.cmd\" subagent-start",
            "timeout": 10,
            "statusMessage": "SubagentへToolUseProxyの保護範囲を伝えています"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/run_hook.sh\" pre-tool-use",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run_hook.cmd\" pre-tool-use",
            "timeout": 10,
            "statusMessage": "送信前に保護対象が含まれていないか確認しています"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|apply_patch|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/run_hook.sh\" post-tool-use",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run_hook.cmd\" post-tool-use",
            "timeout": 10,
            "statusMessage": "ツールの実行記録をこの端末に保存しています"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/run_hook.sh\" stop",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run_hook.cmd\" stop",
            "timeout": 10,
            "statusMessage": "回答に保護対象が含まれていないか確認しています"
          }
        ]
      }
    ]
  }
}
