{
  "description": "Semantic dependency graphs judged by Codex with evidence acquisition and output-scoped provenance. Incomplete judgments retain the operation; they never grant permission.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/run_hook.sh\" session-start",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run_hook.cmd\" session-start",
            "timeout": 900
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/run_hook.sh\" subagent-start",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run_hook.cmd\" subagent-start",
            "timeout": 900
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^.*$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/run_hook.sh\" pre-tool-use",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run_hook.cmd\" pre-tool-use",
            "timeout": 900
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^.*$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/run_hook.sh\" post-tool-use",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run_hook.cmd\" post-tool-use",
            "timeout": 900
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/hooks/run_hook.sh\" stop",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run_hook.cmd\" stop",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
